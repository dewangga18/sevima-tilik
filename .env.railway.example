# ==============================================================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Gunakan nilai-nilai di bawah ini saat mengisi "Variables" di dashboard Railway.

# ------------------------------------------------------------------------------
# 1. SERVICE: POSTGRESQL (Railway Database Plugin)
# ------------------------------------------------------------------------------
# Railway otomatis membuat variabel ini:
# - DATABASE_URL (misal: postgresql://postgres:xxx@postgres.railway.internal:5432/railway)
# Kamu tidak perlu ubah apa-apa di tab variables database.

# ------------------------------------------------------------------------------
# 2. SERVICE: BACKEND API (apps/api)
# ------------------------------------------------------------------------------
# Setting di Railway:
# - Root Directory: apps/api
# - Dockerfile Path: Dockerfile (atau biarkan default)

# Variables yang diisi di tab "Variables" service API:
APP_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
ALLOWED_ORIGIN=https://tilik-web-production.up.railway.app
PORT=8080
ENABLE_DEMO_LOGIN=true

# Catatan: Ganti ALLOWED_ORIGIN dengan domain publik yang di-generate untuk Frontend Web.

# ------------------------------------------------------------------------------
# 3. SERVICE: FRONTEND WEB (apps/web)
# ------------------------------------------------------------------------------
# Setting di Railway:
# - Root Directory: apps/web
# - Dockerfile Path: Dockerfile
# - Settings -> Networking -> Port: 80 (karena Nginx di Dockerfile expose port 80)

# Variables yang diisi di tab "Variables" service Web:
VITE_API_URL=https://tilik-api-production.up.railway.app
VITE_ENABLE_DEMO=true

# Catatan:
# 1. Ganti VITE_API_URL dengan domain publik yang di-generate untuk Backend API.
# 2. VITE_ENABLE_DEMO=true memunculkan tombol 1-klik Quick Login Demo untuk juri.
