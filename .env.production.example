# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to git

# --- Application ---
APP_ENV=production

# --- API ---
API_PORT=8080
PORT=8080

# --- Web (Build Argument - NOT runtime env) ---
# This must be passed during docker build:
# docker build --build-arg VITE_API_URL=https://api.yourdomain.com ...
VITE_API_URL=https://api.yourdomain.com

# --- CORS ---
# Set this to your actual frontend domain
ALLOWED_ORIGIN=https://tilik.yourdomain.com

# --- Database ---
DB_USER=tilik
DB_NAME=tilik_db
# ⚠️  CHANGE THIS PASSWORD - Generate a strong random password (min 16 chars)
# Example: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Database connection string
# For managed DB (RDS, Supabase, Cloud SQL): use sslmode=require
# For self-hosted with SSL: use sslmode=require
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?sslmode=require

# If using external managed database, replace 'db' with actual host:
# DATABASE_URL=postgres://tilik:YOUR_PASSWORD@db.example.com:5432/tilik_db?sslmode=require

# --- Security Notes ---
# 1. Generate strong DB_PASSWORD: openssl rand -base64 24
# 2. Never expose DB_PORT to public (remove from docker-compose ports)
# 3. Use HTTPS reverse proxy (nginx/Caddy/Traefik) in front of API and Web
# 4. Ensure cookie Secure flag is enabled (handled by APP_ENV=production)
# 5. Demo login is automatically disabled in production

# --- Optional: Postgres Port (DO NOT EXPOSE IN PRODUCTION) ---
# Only set if you need internal access for debugging
# DB_PORT=5432
